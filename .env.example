DATABASE_URL=postgresql+psycopg://assistant:local-development-only@localhost:5432/assistant
# Each client has a distinct token and owns its own conversations.
# Generate tokens with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_CLIENTS={"local-user":"replace-with-a-random-token-of-at-least-32-characters"}
SESSION_TTL_SECONDS=86400
# Keep fake until secure credential setup and a live-provider smoke test are complete.
LLM_PROVIDER=fake
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=8
# Optional deployment-controlled reviewed JSON registry. Unset means no trusted services.
# SERVICE_REGISTRY_PATH=/absolute/path/to/reviewed-registry.json
# APCPDCL assisted handoff preset: SERVICE_REGISTRY_PATH=registry/apcpdcl.json
SEARCH_PROVIDER=disabled
SEARCH_TIMEOUT_SECONDS=5
# brave requires BRAVE_SEARCH_API_KEY through secure environment configuration.
